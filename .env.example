# Vercel 프로젝트 Settings → Environment Variables 에 아래 항목을 등록하세요.
# (이 파일 자체는 예시일 뿐이며 실제 값을 채워서 커밋하지 마세요.)

# 패스키(Face ID/Touch ID/YubiKey)가 어느 사이트용인지 브라우저에 알려주는 값.
# RP_ID는 프로토콜 없이 도메인만, ORIGIN은 https://까지 포함해서 정확히 일치해야 합니다.
RP_ID=para-beryl-rho.vercel.app
ORIGIN=https://para-beryl-rho.vercel.app

# 세션 쿠키 + 등록/로그인 중간 challenge 쿠키 서명용 긴 비밀 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=

# 새 기기(패스키) 등록 페이지(register.html)를 보호하는 긴 비밀 문자열.
# "https://<도메인>/register.html?token=이값" 링크를 가족 등록할 때만 사용하고
# 평소엔 아무에게도 공유하지 마세요. (예: openssl rand -hex 24)
SETUP_TOKEN=

# 등록된 패스키 자격 증명 목록 (JSON 배열, register.html에서 등록 후 나오는 값을
# 그대로 복붙). 처음엔 비워두고, 첫 기기를 등록한 뒤 그 결과로 채우면 됩니다.
# 예: [{"id":"...","publicKey":"...","counter":0,"label":"다솜이 아이폰"}]
WEBAUTHN_CREDENTIALS=[]

# ── 더 이상 쓰지 않음(Discord 로그인 제거됨) — 있어도 무해하니 정리는 선택사항 ──
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=
# DISCORD_ALLOWED_USER_ID=
