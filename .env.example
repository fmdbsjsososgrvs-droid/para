# Vercel 프로젝트 Settings → Environment Variables 에 아래 항목을 등록하세요.
# (이 파일 자체는 예시일 뿐이며 실제 값을 채워서 커밋하지 마세요.)

# Discord Developer Portal → 애플리케이션 → OAuth2 → General
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 이 값과 100% 동일한 주소가 Discord OAuth2 → Redirects 에도 등록되어 있어야 합니다.
DISCORD_REDIRECT_URI=https://para-beryl-rho.vercel.app/api/auth/callback

# 로그인 허용할 유일한 Discord 사용자 ID (본인 계정, 개발자 모드 켜고 "ID 복사"로 확인)
DISCORD_ALLOWED_USER_ID=

# 세션 쿠키 서명용 임의의 긴 비밀 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
